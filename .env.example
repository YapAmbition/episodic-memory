# 默认仅监听本机。通过反向代理访问时配置服务令牌和 HTTPS。
MEMORY_BIND=127.0.0.1
MEMORY_PORT=8000
MEMORY_API_TOKEN=
# /metrics 单独令牌；留空时沿用 MEMORY_API_TOKEN。
MEMORY_METRICS_TOKEN=
MODEL_MAX_CONCURRENT=3
# 可选：由后端环境提供模型密钥，浏览器不会读取该值。
MODEL_API_KEY=
# 首次启动是否导入虚构示例；已有空间时不会重复导入。
SEED_DEMO=true

# 可选远程向量密钥；地址和模型名在页面配置。无需下载本地模型。
EMBEDDING_API_KEY=
